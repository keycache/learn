{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic Metadata Schema",
  "description": "Metadata for a learning topic, including list of available lessons",
  "type": "object",
  "required": ["id", "name", "description", "category", "subcategory", "lessons"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the topic",
      "pattern": "^[a-z]+(-[a-z]+)*$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Display name of the topic",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the topic",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "description": "Parent category ID",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "subcategory": {
      "type": "string",
      "description": "Parent subcategory ID",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "lessons": {
      "type": "array",
      "description": "List of available lessons for this topic",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Lesson identifier (matches markdown filename without .md)",
            "pattern": "^lesson_\\d+$",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "description": "Display order of this lesson",
            "minimum": 1
          }
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Version of this topic metadata",
      "pattern": "^\\d+\\.\\d+$"
    },
    "createdAt": {
      "type": "string",
      "description": "Creation date in YYYY-MM-DD format",
      "format": "date"
    }
  }
}
