{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Category Metadata Schema",
  "description": "Metadata for a learning category (e.g., spoken-languages, system-design)",
  "type": "object",
  "required": ["id", "name", "description", "subcategories"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the category",
      "pattern": "^[a-z]+(-[a-z]+)*$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Display name of the category",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the category",
      "minLength": 1
    },
    "subcategories": {
      "type": "array",
      "description": "List of subcategories in this category",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "createdAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
