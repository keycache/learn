{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Subcategory Metadata Schema",
  "description": "Metadata for a learning subcategory (e.g., french, spanish within spoken-languages)",
  "type": "object",
  "required": ["id", "name", "description", "category", "topics", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the subcategory",
      "pattern": "^[a-z]+(-[a-z]+)*$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Display name of the subcategory",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the subcategory",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "description": "Parent category ID",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "topics": {
      "type": "array",
      "description": "List of available topics in this subcategory",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Topic identifier (matches JSON filename without .json)",
            "pattern": "^[a-z]+(-[a-z]+)*$",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Display name for the topic",
            "minLength": 1
          }
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Version of this subcategory metadata",
      "pattern": "^\\d+\\.\\d+$"
    },
    "createdAt": {
      "type": "string",
      "description": "Creation date in YYYY-MM-DD format",
      "format": "date"
    }
  }
}
