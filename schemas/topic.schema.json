{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic Schema",
  "description": "Schema for a learning topic containing questions across three difficulty levels (easy, medium, hard)",
  "type": "object",
  "required": ["id", "name", "description", "category", "subcategory", "levels"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the topic",
      "pattern": "^[a-z]+(-[a-z]+)*$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Display name of the topic",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the topic",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "description": "Parent category ID",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "subcategory": {
      "type": "string",
      "description": "Parent subcategory ID",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "levels": {
      "type": "object",
      "description": "Three difficulty levels for this topic",
      "required": ["easy", "medium", "hard"],
      "additionalProperties": false,
      "properties": {
        "easy": {
          "$ref": "#/definitions/level"
        },
        "medium": {
          "$ref": "#/definitions/level"
        },
        "hard": {
          "$ref": "#/definitions/level"
        }
      }
    }
  },
  "definitions": {
    "level": {
      "type": "object",
      "description": "A single difficulty level with 30 questions",
      "required": ["level", "questionCount", "questions"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "Difficulty level identifier"
        },
        "description": {
          "type": "string",
          "description": "Description of this level"
        },
        "questionCount": {
          "type": "integer",
          "minimum": 30,
          "maximum": 30,
          "description": "Must be exactly 30 questions per level"
        },
        "questions": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "description": "Array of exactly 30 questions",
          "items": {
            "$ref": "#/definitions/question"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "description": "A single quiz question",
      "required": ["id", "text", "options", "correctAnswers"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the question within the topic",
          "pattern": "^q-[a-z]+-[0-9]{2}$",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "The question text",
          "minLength": 5
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "Array of exactly 4 answer options",
          "items": {
            "$ref": "#/definitions/option"
          }
        },
        "correctAnswers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "Array of one or more correct option IDs",
          "items": {
            "type": "string",
            "pattern": "^opt-"
          }
        },
        "explanation": {
          "type": "string",
          "description": "Explanation of the correct answer"
        }
      }
    },
    "option": {
      "type": "object",
      "description": "A single answer option",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this option",
          "pattern": "^opt-[a-z]+-[0-9]{2}-[a-d]$",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "The option text",
          "minLength": 1
        }
      }
    }
  }
}
