{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated Quiz Schema",
  "description": "Schema for generated quizzes with flat question structure and per-question metadata. Compatible with LLM quiz generation output.",
  "type": "object",
  "required": ["title", "lesson_id", "quiz_version", "questions", "metadata"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Descriptive quiz title (e.g., 'French Numbers Quiz - Beginner')",
      "minLength": 1,
      "maxLength": 300
    },
    "lesson_id": {
      "type": "string",
      "description": "Unique identifier of the associated lesson (e.g., 'french/numbers')",
      "minLength": 1
    },
    "quiz_version": {
      "type": "integer",
      "description": "Version number of this quiz (1, 2, 3, ...)",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "description": "Array of quiz questions",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/question"
      }
    },
    "metadata": {
      "$ref": "#/definitions/metadata"
    }
  },
  "definitions": {
    "question": {
      "type": "object",
      "description": "A single quiz question with type, difficulty, and points metadata",
      "required": ["id", "type", "question", "correctAnswer", "explanation", "difficulty", "points"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique question identifier (e.g., 'q-easy-00')"
        },
        "type": {
          "type": "string",
          "enum": ["multiple-choice", "true-false", "short-answer"],
          "description": "Question type: multiple-choice (4 options), true-false (2 options), or short-answer (text response)"
        },
        "question": {
          "type": "string",
          "description": "The question text or prompt",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "description": "Answer options (required for multiple-choice and true-false; should have 4 items for MC, 2 for T/F)",
          "items": {
            "type": "string"
          }
        },
        "correctAnswer": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"}
          ],
          "description": "The correct answer (option text or index for short-answer)"
        },
        "explanation": {
          "type": "string",
          "description": "Detailed explanation of why this is correct, for student learning",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "Question difficulty: easy (recall), medium (comprehension), hard (application/analysis)"
        },
        "points": {
          "type": "integer",
          "description": "Points awarded for correct answer",
          "minimum": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Quiz metadata - contextual information",
      "required": ["totalQuestions", "createdAt", "lessonId"],
      "additionalProperties": false,
      "properties": {
        "totalQuestions": {
          "type": "integer",
          "description": "Total number of questions in this quiz",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when quiz was generated"
        },
        "lessonId": {
          "type": "string",
          "description": "Reference to the lesson this quiz covers",
          "minLength": 1
        }
      }
    }
  }
}
